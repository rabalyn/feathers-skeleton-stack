# Generated from compose.yaml by scripts/quadlet.sh. Do not edit; put
# production settings in a drop-in directory next to this file.

[Unit]
Wants=valkey.service
After=valkey.service

[Container]
ContainerName=valkey-exporter
Exec='--redis.addr=rediss://valkey:6379' '--redis.user=exporter' '--redis.password-file=/run/secrets/passwords.json' '--tls-ca-cert-file=/trust/ca.crt' '--tls-server-cert-file=/tls/tls.crt' '--tls-server-key-file=/tls/tls.key'
Image=docker.io/oliver006/redis_exporter@sha256:0842ef7110e62b40bbde2d5c11f38c6fbd99f7100c75e3866637c1b335a1eff7
Network=app-data.network
Network=observability.network
Volume=valkey-exporter-secrets.volume:/run/secrets:ro
Volume=tls-valkey-exporter:/tls:ro
Volume=trust:/trust:ro

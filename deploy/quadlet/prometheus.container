[Container]
ContainerName=prometheus
Environment=ENVIRONMENT=local
Exec='--config.file=/etc/prometheus/prometheus.yml' '--web.config.file=/etc/observability/web-config.yml' '--storage.tsdb.path=/prometheus' '--storage.tsdb.retention.time=14d'
Image=docker.io/prom/prometheus@sha256:aafa9d694e6a883c02db516d9f6e5b84e14195f49a2a6456a4cca815edda72b9
Memory=1gb
Network=observability.network
PodmanArgs=--cpus 1
Volume=../../containers/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro,Z
Volume=../../containers/prometheus/targets:/etc/prometheus/targets:ro,Z
Volume=../../containers/observability/web-config.yml:/etc/observability/web-config.yml:ro,Z
Volume=prometheus-data:/prometheus
Volume=tls-prometheus:/tls:ro
Volume=trust:/trust:ro

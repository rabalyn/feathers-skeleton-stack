# Generated from compose.yaml by scripts/quadlet.sh. Do not edit; put
# production settings in a drop-in directory next to this file.

[Container]
ContainerName=nginx
Environment=NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 NGINX_TLS_DIR=/etc/nginx/tls NGINX_APP_HOST=app.localhost NGINX_PUBLIC_PORT=8443 NGINX_HTTP_PORT=8080 NGINX_BODY_SIZE_LIMIT=10m NGINX_API_UPSTREAM=api:3030 NGINX_GRAFANA_HOST=grafana.localhost NGINX_GRAFANA_UPSTREAM=grafana:3000 NGINX_NETBOX_HOST=netbox.localhost NGINX_NETBOX_UPSTREAM=netbox:8443
Image=localhost/feathers-nginx:dev
Network=edge.network:alias=app.localhost
Network=grafana-edge.network
Network=netbox-edge.network
PublishPort=127.0.0.1:8443:8443
PublishPort=127.0.0.1:8080:8080
Volume=tls-nginx:/etc/nginx/tls:ro
Volume=trust:/trust:ro

[Unit]
Requires=openbao.service
After=openbao.service

[Container]
ContainerName=backup-agent
Entrypoint=["bao"]
Environment=BAO_ADDR=https://openbao:8200 BAO_CACERT=/openbao/trust/ca.crt
Exec=agent '-config=/openbao/agent/agent.hcl'
Group=1100
Image=docker.io/openbao/openbao@sha256:a36ea8c27f0dcff5757664ad080425f96d3b6b2f33db3e76c4e2d3112fb17005
Network=secrets.network
User=100
Volume=../../containers/openbao/agents/backup.hcl:/openbao/agent/agent.hcl:ro,Z
Volume=../../containers/openbao/agents/backup.role_id:/openbao/agent/role_id:ro,Z
Volume=trust:/openbao/trust:ro
Volume=backup-secrets.volume:/run/secrets
Volume=backup-agent-cred.volume:/run/agent

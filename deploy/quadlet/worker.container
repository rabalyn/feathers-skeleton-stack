# Generated from compose.yaml by scripts/quadlet.sh. Do not edit; put
# production settings in a drop-in directory next to this file.

[Unit]
Requires=migrate.service
After=migrate.service

[Container]
ContainerName=worker
Environment=LOG_FILE=/var/log/app/worker INTERNAL_TLS_CERT_FILE=/tls/tls.crt INTERNAL_TLS_KEY_FILE=/tls/tls.key DATABASE_HOST=pgbouncer DATABASE_PORT=6432 DATABASE_NAME=app DATABASE_USER=worker DATABASE_PASSWORD_FILE=/run/secrets/database_password DATABASE_CA_FILE=/trust/ca.crt VALKEY_HOST=valkey VALKEY_USER=worker VALKEY_PASSWORD_FILE=/run/secrets/valkey_password VALKEY_CA_FILE=/trust/ca.crt S3_ENDPOINT=https://s3:3900 S3_KEY_ID_FILE=/run/secrets/s3_key_id S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key S3_CA_FILE=/trust/ca.crt PUBLIC_ORIGIN=https://app.localhost:8443 SMTP_HOST=mail SMTP_PORT=1025 SMTP_CA_FILE=/trust/ca.crt MAIL_FROM=noreply@app.localhost
Exec=node dist/worker.js
HealthCmd=NODE_EXTRA_CA_CERTS=/trust/ca.crt node -e "fetch('https://localhost:9090/health/live').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
HealthInterval=10s
HealthRetries=3
HealthTimeout=3s
Image=localhost/feathers-api:dev
Network=app-data.network
Network=object.network
Network=observability.network
Volume=worker-secrets.volume:/run/secrets:ro
Volume=trust:/trust:ro
Volume=logs.volume:/var/log/app
Volume=tls-worker:/tls:ro

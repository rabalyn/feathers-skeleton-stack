# Generated from compose.yaml by scripts/quadlet.sh. Do not edit; put
# production settings in a drop-in directory next to this file.

[Unit]
Requires=migrate.service
After=migrate.service

[Container]
ContainerName=api
Environment=PUBLIC_ORIGIN=https://app.localhost:8443 AUTH_SIGNING_SECRET_FILE=/run/secrets/auth_signing_secret REFRESH_TOKEN_KEY_FILE=/run/secrets/refresh_token_key SAML_SP_PRIVATE_KEY_FILE=/run/secrets/saml_sp_key SAML_SP_CERTIFICATE_FILE=/run/secrets/saml_sp_cert SAML_IDP_CERTIFICATE_FILE=/run/secrets/saml_idp_cert SAML_IDP_ENTITY_ID=https://idp.localhost:8443/realms/feathers SAML_IDP_SSO_URL=https://idp.localhost:8443/realms/feathers/protocol/saml SAML_IDP_SLO_URL=https://idp.localhost:8443/realms/feathers/protocol/saml DATABASE_HOST=pgbouncer DATABASE_PORT=6432 DATABASE_NAME=app DATABASE_USER=app DATABASE_PASSWORD_FILE=/run/secrets/database_password DATABASE_CA_FILE=/trust/ca.crt BODY_SIZE_CEILING_BYTES=10485760 VALKEY_HOST=valkey VALKEY_PASSWORD_FILE=/run/secrets/valkey_password VALKEY_CA_FILE=/trust/ca.crt TRUSTED_PROXY_HOST=nginx
HealthCmd=["node","-e","fetch('http://127.0.0.1:9090/health/live').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
HealthInterval=10s
HealthRetries=3
HealthTimeout=3s
Image=localhost/feathers-api:dev
Network=edge.network
Network=app-data.network
Volume=api-secrets.volume:/run/secrets:ro
Volume=trust:/trust:ro

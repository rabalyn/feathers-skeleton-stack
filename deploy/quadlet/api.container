# Generated from compose.yaml by scripts/quadlet.sh. Do not edit; put
# production settings in a drop-in directory next to this file.

[Unit]
Requires=migrate.service
After=migrate.service

[Container]
ContainerName=api
Environment=PUBLIC_ORIGIN=https://app.localhost:8443 LOG_FILE=/var/log/app/api INTERNAL_TLS_CERT_FILE=/tls/tls.crt INTERNAL_TLS_KEY_FILE=/tls/tls.key AUTH_SIGNING_SECRET_FILE=/run/secrets/auth_signing_secret REFRESH_TOKEN_KEY_FILE=/run/secrets/refresh_token_key SAML_SP_PRIVATE_KEY_FILE=/run/secrets/saml_sp_key SAML_SP_CERTIFICATE_FILE=/run/secrets/saml_sp_cert SAML_IDP_CERTIFICATE_FILE=/run/secrets/saml_idp_cert SAML_IDP_ENTITY_ID=https://idp.localhost:8443/realms/feathers SAML_IDP_SSO_URL=https://idp.localhost:8443/realms/feathers/protocol/saml SAML_IDP_SLO_URL=https://idp.localhost:8443/realms/feathers/protocol/saml DATABASE_HOST=pgbouncer DATABASE_PORT=6432 DATABASE_NAME=app DATABASE_USER=app DATABASE_PASSWORD_FILE=/run/secrets/database_password DATABASE_CA_FILE=/trust/ca.crt BODY_SIZE_CEILING_BYTES=10485760 VALKEY_HOST=valkey VALKEY_USER=api VALKEY_PASSWORD_FILE=/run/secrets/valkey_password VALKEY_CA_FILE=/trust/ca.crt TRUSTED_PROXY_HOST=nginx LDAP_URL=ldaps://ldap:636 LDAP_BIND_DN=cn=api,ou=services,dc=feathers,dc=test LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password LDAP_BASE_DN=ou=people,dc=feathers,dc=test LDAP_CA_FILE=/trust/ca.crt S3_ENDPOINT=https://s3:3900 S3_KEY_ID_FILE=/run/secrets/s3_key_id S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key S3_CA_FILE=/trust/ca.crt
HealthCmd=NODE_EXTRA_CA_CERTS=/trust/ca.crt node -e "fetch('https://localhost:9090/health/live').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
HealthInterval=10s
HealthRetries=3
HealthTimeout=3s
Image=localhost/feathers-api:dev
Network=edge.network
Network=app-data.network
Network=object.network
Network=observability.network
Volume=api-secrets.volume:/run/secrets:ro
Volume=trust:/trust:ro
Volume=logs.volume:/var/log/app
Volume=tls-api:/tls:ro

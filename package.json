{
  "name": "claude-feathers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:types": "pnpm --filter @app/api --filter @app/feathers-pinia build && pnpm --filter @app/web exec quasar prepare",
    "typecheck": "pnpm build:types && pnpm -r typecheck",
    "test:unit": "pnpm build:types && pnpm --filter './packages/*' --filter @app/web test",
    "lint": "pnpm build:types && eslint . && pnpm --filter @app/api lint:boundary",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "gen:service": "pnpm --filter @app/api gen:service"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "jsonc-eslint-parser": "3.3.0",
    "typescript-eslint": "8.70.1",
    "vue-eslint-parser": "10.4.1"
  }
}

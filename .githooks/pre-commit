#!/bin/sh
# gitleaks on what is about to be committed (ADR 0023), as a backstop; the
# CI gate scans the whole history. Enabled by `pnpm install` (core.hooksPath).
set -eu
GITLEAKS=docker.io/zricethezav/gitleaks@sha256:b109bc5f8f76a38196a3e413704fc5b9e3c32360bce4e4b603bd6f45b3721dbb # v8.30.1
exec podman run --rm --network none -v "$(git rev-parse --show-toplevel):/repo:ro,Z" "$GITLEAKS" \
  git --pre-commit --staged --redact --no-banner /repo

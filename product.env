# The product's identity (ADR 0035): the one place a product built on the
# skeleton names itself. Read by the scripts that drive the stack
# (scripts/product.sh), which pass it to compose.yaml; compose.yaml refuses
# to start without it. Shell syntax: quote a value with spaces.

# The technical project name: lowercase letters, digits and single
# hyphens, starting with a letter and not ending in a hyphen. It names the
# Compose project, the local images, volumes, networks and containers
# (<project>-api), and the local host names (app.<project>.localhost).
PRODUCT=feathers-skeleton

# What people read: the browser title, the e-mail sender name, key labels.
PRODUCT_DISPLAY_NAME=mmAG-skeleton

# The local ports the stack publishes on 127.0.0.1, distinct per product
# so that several products' stacks run side by side.
PRODUCT_HTTPS_PORT=8443
PRODUCT_HTTP_PORT=8080

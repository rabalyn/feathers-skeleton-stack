{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint:boundary": "depcruise src/client.ts --config .dependency-cruiser.cjs",
    "gen:service": "pinion generators/service.ts",
    "gen:check": "bash generators/check.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@casl/ability": "6.8.1",
    "@feathersjs/authentication": "5.0.50",
    "@feathersjs/authentication-client": "5.0.50",
    "@feathersjs/errors": "5.0.50",
    "@feathersjs/feathers": "5.0.50",
    "@feathersjs/knex": "5.0.50",
    "@feathersjs/koa": "5.0.50",
    "@feathersjs/schema": "5.0.50",
    "@feathersjs/socketio": "5.0.50",
    "@feathersjs/typebox": "5.0.50",
    "@node-saml/node-saml": "5.1.0",
    "@smithy/node-http-handler": "4.12.1",
    "@xmldom/xmldom": "0.8.15",
    "bullmq": "6.3.8",
    "cron-parser": "5.10.1",
    "feathers-casl": "3.0.0",
    "feathers-utils": "10.8.3",
    "file-type": "22.1.1",
    "ioredis": "6.0.0",
    "knex": "3.3.0",
    "ldapts": "9.2.0",
    "liquidjs": "10.29.0",
    "markdown-it": "15.0.2",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "prom-client": "15.1.3",
    "xpath": "0.0.34",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@featherscloud/pinion": "0.5.7",
    "@feathersjs/socketio-client": "5.0.50",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/xml-encryption": "^1.2.4",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.0",
    "selfsigned": "^5.5.0",
    "socket.io-client": "4.8.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "xml-crypto": "^6.3.1",
    "xml-encryption": "^3.1.0",
    "yauzl": "3.4.0"
  }

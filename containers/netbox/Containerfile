# NetBox (ADR 0031): the upstream image with this stack's configuration,
# the SAML group sync, the setup job and the seed files baked in, so the
# image production pulls carries the data it seeds.
FROM docker.io/netboxcommunity/netbox:v4.7.4-5.1.1@sha256:69cd72d0b0e4928a90940a7011954aaa7060c75fddd8dc6cea2f19407bae45b1
COPY containers/netbox/config/feathers.py /etc/netbox/config/feathers.py
COPY containers/netbox/feathers_netbox /opt/netbox/netbox/feathers_netbox
COPY containers/netbox/seed/tu-darmstadt /opt/feathers/seed/tu-darmstadt
COPY containers/netbox/setup.sh /opt/feathers/setup.sh
# Security fixes Ubuntu has released since the upstream image was built
# (ADR 0018), until a NetBox image carries them.
USER root
RUN apt-get update \
 && apt-get install -y --only-upgrade --no-install-recommends openssl libssl3t64 openssl-provider-legacy curl libcurl4t64 \
 && rm -rf /var/lib/apt/lists/*
# Python fixes NetBox's own pins lag behind (ADR 0018): Pillow 13.0.0 and
# certifi 2026.10.19 (2026-10-21; NetBox 4.7.3 pins Pillow 12.3.0, which
# its base requirements leave open). Drop each once a NetBox image has it.
RUN uv pip install --python /opt/netbox/venv/bin/python --no-cache 'pillow==13.0.0' 'certifi==2026.10.19'
# The image's own user; its group is root, as upstream runs it.
USER 999:0
EXPOSE 8443

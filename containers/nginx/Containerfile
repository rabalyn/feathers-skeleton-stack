# Build context: repository root.
ARG NODE_IMAGE=docker.io/library/node:26.10.0-alpine@sha256:b341ca66519d9a1c25d4e41f254ffb6fe403fc0f9054c62b863f0660dcc1c199

# The frontend's dependencies and the built types it imports: the API client
# (ADR 0007) and the feathers-pinia fork (ADR 0014).
FROM ${NODE_IMAGE} AS web-deps
# pnpm at the version package.json names (packageManager), installed with
# the npm bundled with Node, which is then removed: Node 25 and later ship no
# corepack, and npm only carries its own vulnerabilities into the image
# (ADR 0018). /usr/local is readable by every user, so unprivileged targets
# find pnpm without a network (ADR 0015).
COPY package.json /tmp/pnpm-version/
RUN npm install -g --no-fund --no-audit --no-update-notifier \
      "pnpm@$(node -p 'require("/tmp/pnpm-version/package.json").packageManager.split("@")[1].split("+")[0]')" \
 && rm -rf /tmp/pnpm-version /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && pnpm --version
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/feathers-pinia/package.json packages/feathers-pinia/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @app/web...
COPY apps/api apps/api
COPY packages/feathers-pinia packages/feathers-pinia
RUN pnpm --filter @app/api --filter @app/feathers-pinia build
COPY product.env ./
COPY apps/web apps/web

# The Vite dev server of the `dev` profile (ADR 0014); the source is
# bind-mounted over the copy.
FROM web-deps AS web-dev
# Alpine fixes reach the image with every build, not only with a new base
# digest: APK_UPGRADE, the day's date, misses the layer cache once a day.
# Here, not in web-deps, so that the daily miss doesn't rerun the install
# and the build above it (ADR 0018).
ARG APK_UPGRADE=unset
RUN apk upgrade --no-cache && chown -R node:node /repo/apps/web
USER node
WORKDIR /repo/apps/web
EXPOSE 5173
CMD ["./node_modules/.bin/quasar", "dev"]

# The production bundle. Lint, typecheck and unit tests run in CI, not here
# (ADR 0014).
FROM web-deps AS web-build
RUN pnpm --filter @app/web build

# No Node runtime in the served image (ADR 0014).
FROM docker.io/library/nginx:1.31.6-alpine@sha256:0530961ff0592b58c10f767535cc0abdfccf9e389ff7cc90f87320c1bc7e8506
# The official image's dynamic modules go: nginx.conf loads none of them,
# and they bring libgd, libtiff, libxml2 and some thirty other libraries
# along (ADR 0016). Alpine fixes reach the image with every build, not only
# with a new base digest: APK_UPGRADE, the day's date, misses the layer
# cache once a day (ADR 0018).
ARG APK_UPGRADE=unset
RUN apk del --no-cache nginx-module-acme nginx-module-geoip nginx-module-image-filter \
      nginx-module-njs nginx-module-xslt \
 && apk upgrade --no-cache && rm /etc/nginx/conf.d/default.conf
COPY containers/nginx/nginx.conf /etc/nginx/nginx.conf
COPY containers/nginx/templates/ /etc/nginx/templates/
COPY containers/nginx/entrypoint.d/ /docker-entrypoint.d/
COPY --from=web-build /repo/apps/web/dist/spa/ /usr/share/nginx/html/

# Grafana, dashboards and alerting (ADR 0022). In every environment; production
# sets its own host name.
server {
  listen ${NGINX_PUBLIC_PORT} ssl;
  http2 on;
  server_name ${NGINX_GRAFANA_HOST};

  ssl_certificate     ${NGINX_TLS_DIR}/fullchain.crt;
  ssl_certificate_key ${NGINX_TLS_DIR}/tls.key;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $grafana_upstream https://${NGINX_GRAFANA_UPSTREAM};

  location / {
    proxy_pass $grafana_upstream;
    # TLS to the upstream too, verified against the CA root (ADR 0022).
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /trust/ca.crt;
    proxy_ssl_server_name on;
    proxy_ssl_name grafana;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 1h;
  }
}

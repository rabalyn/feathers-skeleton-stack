# The local e2e origin (ADR 0015): the same application, served by the
# `api-e2e` container on a database of its own. Removed where NGINX_E2E_HOST
# is unset, as in production (entrypoint.d/29-e2e-vhost.sh).
server {
  listen ${NGINX_PUBLIC_PORT} ssl;
  http2 on;
  server_name ${NGINX_E2E_HOST};

  ssl_certificate     ${NGINX_TLS_DIR}/fullchain.crt;
  ssl_certificate_key ${NGINX_TLS_DIR}/tls.key;

  client_max_body_size ${NGINX_BODY_SIZE_LIMIT};

  include /etc/nginx/conf.d/snippets/security-headers.conf;

  set $api_upstream http://${NGINX_E2E_API_UPSTREAM};

  include /etc/nginx/conf.d/snippets/app-locations.conf;
}

# Plain HTTP for this name: a permanent redirect to HTTPS, to the matched
# name rather than the request's Host (ADR 0016).
server {
  listen ${NGINX_HTTP_PORT};
  server_name ${NGINX_E2E_HOST};
  return 301 https://$server_name:${NGINX_PUBLIC_PORT}$request_uri;
}

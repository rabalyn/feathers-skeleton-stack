# Local only: Dozzle, a live view of container output (ADR 0002, 0016).
# Removed at startup when NGINX_DOZZLE_HOST is empty, as in production.
server {
  listen ${NGINX_PUBLIC_PORT} ssl;
  http2 on;
  server_name ${NGINX_DOZZLE_HOST};

  ssl_certificate     ${NGINX_TLS_DIR}/fullchain.crt;
  ssl_certificate_key ${NGINX_TLS_DIR}/tls.key;

  # HSTS, nosniff and Referrer-Policy only: the application's CSP,
  # Permissions-Policy and COOP are written for the application, not
  # for this UI (ADR 0016).
  include /etc/nginx/conf.d/snippets/base-headers.conf;

  set $dozzle_upstream http://${NGINX_DOZZLE_UPSTREAM};

  location / {
    proxy_pass $dozzle_upstream;
    proxy_http_version 1.1;
    # Ours are the only ones on the response (base-headers.conf).
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    # Logs and events stream as server-sent events: pass them through
    # unbuffered and keep idle streams open.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }
}

# Plain HTTP for this name: a permanent redirect to HTTPS, to the matched
# name rather than the request's Host (ADR 0016).
server {
  listen ${NGINX_HTTP_PORT};
  server_name ${NGINX_DOZZLE_HOST};
  return 301 https://$server_name:${NGINX_PUBLIC_PORT}$request_uri;
}

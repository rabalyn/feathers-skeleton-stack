// Grafana Alloy, the log shipper (ADR 0021, 0022). Labels stay
// low-cardinality: service, level (the application's lines only) and
// environment. request_id and user_ref stay inside the line.

// The JSON log files on the shared volume: the api's and the worker's at its
// root, the backup service's in a directory of its own (ADR 0017), and
// OpenBao's audit log in another, below.
local.file_match "app" {
  path_targets = [
    {"__path__" = "/var/log/app/*.log"},
    {"__path__" = "/var/log/app/backup/*.log"},
  ]
}

loki.source.file "app" {
  targets    = local.file_match.app.targets
  forward_to = [loki.process.app.receiver]
}

// OpenBao's audit log (ADR 0023): JSON without a service or level field,
// so the service is set here. Rotated files (audit.log.1 …) are not read.
local.file_match "openbao" {
  path_targets = [
    {"__path__" = "/var/log/app/openbao/*.log", "service" = "openbao"},
  ]
}

loki.source.file "openbao" {
  targets    = local.file_match.openbao.targets
  forward_to = [loki.process.labels.receiver]
}

loki.process "app" {
  stage.json {
    expressions = { level = "level", service = "service" }
  }

  stage.labels {
    values = { level = "", service = "" }
  }

  forward_to = [loki.process.labels.receiver]
}

// Only the labels ADR 0021 names; the sources add their own.
loki.process "labels" {
  stage.label_drop {
    values = ["filename", "job"]
  }

  forward_to = [loki.write.loki.receiver]
}

// What the stack's other containers print, as plain text labelled by
// service: Podman logs to the journal, under Compose and Quadlet alike. The
// journal is the host user's, so only this stack's services are kept, by
// name; the api, the worker and the backup service come from their files
// instead, as does OpenBao's audit log (OpenBao's own output stays here).
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal_container_name"]
    regex         = "nginx|postgres|pgbouncer|valkey|openbao|idp|ldap|migrate|s3|prometheus|loki|alloy|grafana|mail|blackbox|.+-exporter|.+-agent"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "service"
  }
}

loki.source.journal "containers" {
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.labels.receiver]
}

loki.write "loki" {
  endpoint {
    url = "https://loki:3100/loki/api/v1/push"

    tls_config {
      ca_file = "/trust/ca.crt"
    }
  }

  external_labels = {
    environment = sys.env("ENVIRONMENT"),
  }
}

# Object storage (ADR 0020): Garage, which speaks S3 without TLS, behind an
# Nginx that terminates TLS in the same container. Garage listens on unix
# sockets only, so no plaintext leaves the container (ADR 0016, 0022).
FROM docker.io/dxflrs/garage@sha256:0d7c74fc8ca6fef68a5a941c0e7558c8b1e92ba3588fa7505400e1350456c796 AS garage
# v2.4.1

FROM docker.io/library/alpine:3.24.2@sha256:d56c381f961d307a21b3ca004cf1e3910f106644aefb1f43e654c8a56c4fd395
# Alpine fixes reach the image with every build, not only with a new base
# digest (ADR 0018).
RUN apk upgrade --no-cache \
 && apk add --no-cache bash curl jq nginx \
 && addgroup -S -g 3900 garage \
 && adduser -S -D -H -u 3900 -G garage garage \
 && install -d -o 3900 -g 3900 -m 0750 /var/lib/garage /run/garage /tmp/nginx
COPY --from=garage /garage /usr/local/bin/garage
COPY containers/s3/garage.toml /etc/garage.toml
COPY containers/s3/nginx.conf /etc/s3/nginx.conf
COPY containers/s3/entrypoint.sh /usr/local/bin/s3-entrypoint
USER 3900:3900
EXPOSE 3900 3903
ENTRYPOINT ["/usr/local/bin/s3-entrypoint"]

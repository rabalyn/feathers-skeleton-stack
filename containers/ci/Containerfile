# Build context: repository root.
# Static checks (ADR 0015, 0018): lint, the client boundary, typecheck and
# dependency audit, over the whole workspace. Only Podman is needed on the
# host; scripts/ci.sh runs this image.
ARG NODE_IMAGE=docker.io/library/node:24.21.0-trixie-slim@sha256:b64fccfbcd1ae10d11b969a868b50e1c2530a7054813d5cdea04ac3bce551697

FROM ${NODE_IMAGE}
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json eslint.config.js ./
COPY apps/api/package.json apps/api/
COPY e2e/package.json e2e/
RUN pnpm install --frozen-lockfile
COPY apps/api apps/api
COPY e2e e2e
RUN chown -R node:node /repo
USER node
CMD ["pnpm", "lint"]

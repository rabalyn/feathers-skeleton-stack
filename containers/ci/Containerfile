# Build context: repository root.
# Static checks (ADR 0015, 0018): lint, the client boundary, typecheck,
# unit tests that need no stack, and dependency audit, over the whole
# workspace. Only Podman is needed on the host; scripts/ci.sh runs this image.
ARG NODE_IMAGE=docker.io/library/node:26.10.0-alpine@sha256:b341ca66519d9a1c25d4e41f254ffb6fe403fc0f9054c62b863f0660dcc1c199

FROM ${NODE_IMAGE}
# Alpine fixes with every build (ADR 0018), and bash for the scripts the
# checks run (the service generator's drift check, ADR 0030).
RUN apk upgrade --no-cache && apk add --no-cache bash
# Dependencies are fixed when the image is built; pnpm's pre-run check would
# see the build's lockfile and manifest writes as drift and try to reinstall
# as the unprivileged user (ADR 0015).
ENV pnpm_config_verify_deps_before_run=false
# pnpm at the version package.json names (packageManager), installed with
# the npm bundled with Node, which is then removed: Node 25 and later ship no
# corepack, and npm only carries its own vulnerabilities into the image
# (ADR 0018). /usr/local is readable by every user, so unprivileged targets
# find pnpm without a network (ADR 0015).
COPY package.json /tmp/pnpm-version/
RUN npm install -g --no-fund --no-audit --no-update-notifier \
      "pnpm@$(node -p 'require("/tmp/pnpm-version/package.json").packageManager.split("@")[1].split("+")[0]')" \
 && rm -rf /tmp/pnpm-version /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && pnpm --version
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json eslint.config.js product.env ./
COPY apps/api/package.json apps/api/
COPY packages/feathers-pinia/package.json packages/feathers-pinia/
COPY apps/web/package.json apps/web/
COPY e2e/package.json e2e/
RUN pnpm install --frozen-lockfile
COPY apps/api apps/api
COPY apps/web apps/web
COPY packages packages
COPY e2e e2e
RUN chown -R node:node /repo
USER node
CMD ["pnpm", "lint"]

# Build context: repository root.
# Static checks (ADR 0015, 0018): lint, the client boundary, typecheck,
# unit tests that need no stack, and dependency audit, over the whole
# workspace. Only Podman is needed on the host; scripts/ci.sh runs this image.
ARG NODE_IMAGE=docker.io/library/node:24.21.0-trixie-slim@sha256:b64fccfbcd1ae10d11b969a868b50e1c2530a7054813d5cdea04ac3bce551697

FROM ${NODE_IMAGE}
# corepack keeps pnpm in COREPACK_HOME, not in root's home, so `node` finds
# it without a network (ADR 0015).
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH COREPACK_ENABLE_DOWNLOAD_PROMPT=0 COREPACK_HOME=/corepack
# Dependencies are fixed when the image is built; pnpm's pre-run check would
# see the build's lockfile and manifest writes as drift and try to reinstall
# as the unprivileged user (ADR 0015).
ENV pnpm_config_verify_deps_before_run=false
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json eslint.config.js ./
# The pnpm version package.json names, fetched once here; afterwards corepack
# never reaches the network, so a missing copy fails loudly instead.
RUN corepack install && chmod -R a+rX /corepack
ENV COREPACK_ENABLE_NETWORK=0
COPY apps/api/package.json apps/api/
COPY packages/feathers-pinia/package.json packages/feathers-pinia/
COPY apps/web/package.json apps/web/
COPY e2e/package.json e2e/
RUN pnpm install --frozen-lockfile
COPY apps/api apps/api
COPY apps/web apps/web
COPY packages packages
COPY e2e e2e
RUN chown -R node:node /repo
USER node
CMD ["pnpm", "lint"]

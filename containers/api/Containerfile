# Build context: repository root.
ARG NODE_IMAGE=docker.io/library/node:26.10.0-trixie-slim@sha256:0e6e6feab3409d135561b2dac7f75dad902ceb5e14c35de4521155779ae70cee
# restic 0.19.1, a static binary (ADR 0017).
ARG RESTIC_IMAGE=docker.io/restic/restic@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510

FROM ${RESTIC_IMAGE} AS restic

FROM ${NODE_IMAGE} AS base
# OpenSSL from the distribution's security updates, until the pinned base
# image carries it (CVE-2026-75804, CVE-2026-84782; ADR 0018). Remove once
# a rebuilt base is pinned.
RUN export DEBIAN_FRONTEND=noninteractive \
 && apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade libssl3t64 openssl-provider-legacy openssl \
 && rm -rf /var/lib/apt/lists/*
# Dependencies are fixed when the image is built; pnpm's pre-run check would
# see the build's lockfile and manifest writes as drift and try to reinstall
# as the unprivileged user (ADR 0015).
ENV pnpm_config_verify_deps_before_run=false
# pnpm at the version package.json names (packageManager), installed with
# the npm bundled with Node, which is then removed: Node 25 and later ship no
# corepack, and npm only carries its own vulnerabilities into the image
# (ADR 0018). /usr/local is readable by every user, so unprivileged targets
# find pnpm without a network (ADR 0015).
COPY package.json /tmp/pnpm-version/
RUN npm install -g --no-fund --no-audit --no-update-notifier \
      "pnpm@$(node -p 'require("/tmp/pnpm-version/package.json").packageManager.split("@")[1].split("+")[0]')" \
 && rm -rf /tmp/pnpm-version /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && pnpm --version
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/

# Full dependency set; also the base of the `test` target (ADR 0015).
FROM base AS build
RUN pnpm install --frozen-lockfile --filter @app/api...
COPY apps/api apps/api
RUN pnpm --filter @app/api build

FROM build AS test
# Vitest writes a bundled copy of its config next to the original.
RUN chown -R node:node /repo/apps/api
WORKDIR /repo/apps/api
USER node
CMD ["pnpm", "exec", "vitest", "run"]

FROM base AS prod-deps
RUN pnpm install --frozen-lockfile --prod --filter @app/api...

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
# OpenSSL from the distribution's security updates, until the pinned base
# image carries it (CVE-2026-75804, CVE-2026-84782; ADR 0018). Remove once
# a rebuilt base is pinned.
RUN export DEBIAN_FRONTEND=noninteractive \
 && apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade libssl3t64 openssl-provider-legacy openssl \
 && rm -rf /var/lib/apt/lists/*
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
WORKDIR /repo
COPY --from=prod-deps /repo/node_modules node_modules
COPY --from=prod-deps /repo/apps/api/node_modules apps/api/node_modules
COPY --from=build /repo/apps/api/package.json apps/api/
COPY --from=build /repo/apps/api/dist apps/api/dist
WORKDIR /repo/apps/api
USER node
EXPOSE 3030 9090
CMD ["node", "dist/index.js"]

# The backup service (ADR 0017): the runtime, plus restic and the pg_dump of
# PostgreSQL 18 from the PostgreSQL project's Debian repository (Debian 13
# ships 17, which refuses to dump an 18 server). Its own user and group:
# Debian's system user `backup`, moved to an ID of its own, and a member of
# GID 1000, Valkey's group in its image (ADR 0010), to read Valkey's
# snapshot file (in this image, 1000 is the group `node`).
FROM runtime AS backup
USER root
RUN export DEBIAN_FRONTEND=noninteractive \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates postgresql-common \
 && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
 && apt-get install -y --no-install-recommends postgresql-client-18 \
 && apt-get purge -y --auto-remove postgresql-common \
 && rm -rf /var/lib/apt/lists/* \
 && groupmod -g 1100 backup \
 && usermod -u 1100 -g 1100 -d /var/lib/backup backup \
 && usermod -a -G 1000 backup \
 && install -d -o 1100 -g 1100 -m 0750 /var/lib/backup /srv/backups
COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY containers/backup/entrypoint.sh /usr/local/bin/backup-entrypoint
ENTRYPOINT ["sh", "/usr/local/bin/backup-entrypoint"]
CMD ["node", "dist/backup.js"]

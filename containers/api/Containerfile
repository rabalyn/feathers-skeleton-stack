# Build context: repository root.
ARG NODE_IMAGE=docker.io/library/node:26.10.0-alpine@sha256:b341ca66519d9a1c25d4e41f254ffb6fe403fc0f9054c62b863f0660dcc1c199
# The Alpine release NODE_IMAGE is built on; the runtime is this plus the
# node binary (ADR 0006).
ARG ALPINE_IMAGE=docker.io/library/alpine:3.24.2@sha256:d56c381f961d307a21b3ca004cf1e3910f106644aefb1f43e654c8a56c4fd395
# restic 0.19.1, a static binary (ADR 0017).
ARG RESTIC_IMAGE=docker.io/restic/restic@sha256:136600b6ff6843d61d355f7f71f460a166429f35de6fd11b568fece3c9a4d510

FROM ${RESTIC_IMAGE} AS restic

FROM ${NODE_IMAGE} AS base
# Alpine fixes reach the image with every build, not only with a new base
# digest (ADR 0018).
RUN apk upgrade --no-cache
# Dependencies are fixed when the image is built; pnpm's pre-run check would
# see the build's lockfile and manifest writes as drift and try to reinstall
# as the unprivileged user (ADR 0015).
ENV pnpm_config_verify_deps_before_run=false
# pnpm at the version package.json names (packageManager), installed with
# the npm bundled with Node, which is then removed: Node 25 and later ship no
# corepack, and npm only carries its own vulnerabilities into the image
# (ADR 0018). /usr/local is readable by every user, so unprivileged targets
# find pnpm without a network (ADR 0015).
COPY package.json /tmp/pnpm-version/
RUN npm install -g --no-fund --no-audit --no-update-notifier \
      "pnpm@$(node -p 'require("/tmp/pnpm-version/package.json").packageManager.split("@")[1].split("+")[0]')" \
 && rm -rf /tmp/pnpm-version /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && pnpm --version
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/

# Full dependency set; also the base of the `test` target (ADR 0015).
FROM base AS build
RUN pnpm install --frozen-lockfile --filter @app/api...
COPY apps/api apps/api
RUN pnpm --filter @app/api build

FROM build AS test
COPY docs/adr_v2 /repo/docs/adr_v2
COPY docs/adr_product /repo/docs/adr_product
# The web app's catalogues, which describe every runtime setting (ADR 0025).
COPY apps/web/src/i18n /repo/apps/web/src/i18n
# Vitest writes a bundled copy of its config next to the original.
RUN chown -R node:node /repo/apps/api
WORKDIR /repo/apps/api
USER node
CMD ["pnpm", "exec", "vitest", "run"]

FROM base AS prod-deps
# Without the type-only packages dependencies pull in as dependencies or
# peers (`typescript` through @feathersjs/schema, `@types/*`, `type-fest`):
# nothing loads them at runtime.
RUN pnpm install --frozen-lockfile --prod --filter @app/api... \
 && rm -rf node_modules/.pnpm/typescript@* node_modules/.pnpm/@types+* node_modules/.pnpm/type-fest@*

FROM ${NODE_IMAGE} AS node

# The runtime is Alpine with the node binary and the C++ runtime it links,
# and the Node image's user `node` (1000:1000): no npm, no headers, no
# Yarn, rather than removing them in a layer above (ADR 0006, 0018).
FROM ${ALPINE_IMAGE} AS runtime-base
ENV NODE_ENV=production
RUN apk upgrade --no-cache \
 && apk add --no-cache libstdc++ libgcc \
 && addgroup -g 1000 node \
 && adduser -u 1000 -G node -s /bin/sh -D node
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /repo
COPY --from=prod-deps /repo/node_modules node_modules
COPY --from=prod-deps /repo/apps/api/node_modules apps/api/node_modules
COPY --from=build /repo/apps/api/package.json apps/api/
COPY --from=build /repo/apps/api/dist apps/api/dist
WORKDIR /repo/apps/api
USER node
EXPOSE 3030 9090
CMD ["node", "dist/index.js"]

# The commit the image was built from, for the system-info page (ADR 0032).
# Last, and not in the backup image, so a new commit rebuilds one layer.
# The commit time, not the build time: an unchanged tree builds the same
# image, and `stack.sh up` restarts nothing.
FROM runtime-base AS runtime
# The skeleton's and the product's ADRs and diagrams, for the docs service
# (ADR 0019, 0035). Not in the backup image, which serves nothing.
COPY docs/adr_v2 /repo/docs/adr_v2
COPY docs/adr_product /repo/docs/adr_product
ARG APP_COMMIT=unknown
ARG APP_COMMIT_TIME=unknown
ARG APP_DIRTY=false
ENV APP_COMMIT=${APP_COMMIT} APP_COMMIT_TIME=${APP_COMMIT_TIME} APP_DIRTY=${APP_DIRTY}

# The backup service (ADR 0017): the runtime, plus restic and the pg_dump of
# PostgreSQL 18 from Alpine's packages, the server's release, without Perl
# or a version wrapper. Its own user and group `backup` (1100), a member of
# GID 1000, Valkey's group in its image (ADR 0010), to read Valkey's
# snapshot file (in this image, 1000 is the group `node`). setpriv drops to
# it in the entrypoint.
FROM runtime-base AS backup
USER root
RUN apk add --no-cache postgresql18-client setpriv \
 && addgroup -S -g 1100 backup \
 && adduser -S -D -H -u 1100 -G backup -h /var/lib/backup backup \
 && addgroup backup node \
 && install -d -o 1100 -g 1100 -m 0750 /var/lib/backup /srv/backups
COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY containers/backup/entrypoint.sh /usr/local/bin/backup-entrypoint
ENTRYPOINT ["sh", "/usr/local/bin/backup-entrypoint"]
CMD ["node", "dist/backup.js"]
